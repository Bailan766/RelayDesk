{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RelayDesk",
  "version": "1.2.0",
  "identifier": "app.relaydesk.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "RelayDesk", "width": 1200, "height": 800, "minWidth": 700, "minHeight": 540 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost" } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../build-resources/sing-box.exe": "sing-box.exe",
      "../build-resources/mihomo.exe": "mihomo.exe",
      "../build-resources/Country.mmdb": "Country.mmdb",
      "../build-resources/geoip.metadb": "geoip.metadb",
      "../build-resources/THIRD-PARTY-MIHOMO-LICENSE.txt": "THIRD-PARTY-MIHOMO-LICENSE.txt",
      "../build-resources/THIRD-PARTY-SING-BOX-LICENSE.txt": "THIRD-PARTY-SING-BOX-LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "network-recovery-v1.txt": "network-recovery-v1.txt"
    },
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "./network-hooks.nsh" } }
  }
}
